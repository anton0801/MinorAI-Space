    "NSCameraUsageDescription" : {
      "comment" : "Privacy - usage description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minor scans your notes, slides or a whiteboard to turn them into a mind map. The text is read on your iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minor сканирует конспекты, слайды или доску, чтобы превратить их в карту. Текст распознаётся на вашем iPhone."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - usage description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minor listens while you dictate a message or talk through an idea for a mind map."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minor слушает, пока вы диктуете сообщение или проговариваете идею для карты."
