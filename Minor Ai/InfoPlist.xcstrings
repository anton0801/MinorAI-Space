    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - usage description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minor listens while you dictate a message or talk through an idea for a mind map."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Minor слушает, пока вы диктуете сообщение или проговариваете идею для карты."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - usage description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Minor saves the mind map images you export to your photo library."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Minor сохраняет экспортированные изображения карт в вашу медиатеку."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy - usage description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minor turns your voice into text on your iPhone. The text is sent to AI only when you send a message or build a map."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Minor превращает голос в текст на вашем iPhone. Текст отправляется ИИ, только когда вы отправите сообщение или построите карту."
          }
        }
      }
    }
